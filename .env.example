COMPOSE_PROJECT_NAME=operator-trace
FRONTEND_PORT=18244
BACKEND_PORT=19244
DB_PORT=17744
JWT_SECRET=operator-trace-local-demo-secret-change-before-use
SEED_DEMO=true
# 份额调度：全局默认容量、单数据集默认容量、单 worker 进程并发领取数
DEFAULT_GLOBAL_CAPACITY=8
DEFAULT_DATASET_CAPACITY=6
WORKER_CONCURRENCY=2
WORKER_IDLE_POLL=1.0
